<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Symarow</title>
    <link rel="stylesheet" href="/static/css/style.css">
    <link rel="stylesheet" href="/static/css/index.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
</head>
<body class="index-page">
    <header class="index-header">
        <a href="{{ path('home') }}" class="index-logo">Symarow</a>
        <nav class="index-nav">
            <a href="{{ path('home') }}" class="index-nav-link">Home</a>
            <a href="{{ path('dashboard') }}" class="index-nav-link">Dashboard</a>
            <a href="{{ path('auth_login') }}" class="index-nav-link index-btn-login">Login</a>
        </nav>
    </header>
    <main class="index-main">
        <section class="index-hero">
            <h1>Welcome to Symarow</h1>
            <p class="index-hero-lead">Your role-based platform for products, value streams, and architecture.</p>
            <a href="{{ path('auth_login') }}" class="index-cta">Sign in</a>
        </section>
        <section class="index-section">
            <h2>Get started</h2>
            <p>Sign in with your account to access the dashboard tailored to your role.</p>
        </section>
    </main>
    <footer class="index-footer">
        <p>&copy; {{ "now"|date("Y") }} Symarow</p>
    </footer>
</body>
</html>
